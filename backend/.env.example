# ---- Gemini / OpenAI ----
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
FAST_MODEL=gemini-3.5-flash-lite
STANDARD_MODEL=gemini-3.6-flash

# ---- CSInfo Central Database (resolves client DB & Server IP by ClientRegId) ----
CSINFO_DB_SERVER=165.99.53.25
CSINFO_DB_DATABASE=CSinfo
CSINFO_DB_PORT=0
CSINFO_DB_USER=SoftTradeUser
CSINFO_DB_PASSWORD=SoftTrade$2336225
CSINFO_DB_ENCRYPT=false
CSINFO_DB_TRUST_SERVER_CERTIFICATE=true

# Optional secondary/testing CSInfo server fallback
CSINFO_FALLBACK_SERVER=162.4.140.2
CSINFO_FALLBACK_USER=SoftTradeWebUser
CSINFO_FALLBACK_PASSWORD=SoftTrade$2336225

# ---- Default / Fallback SQL Server Options ----
# Client DB_SERVER and DB_DATABASE are resolved dynamically from CSInfo by ClientRegId.
# Optional fallback if running standalone without ERP context:
# DB_SERVER=162.4.140.2
# DB_DATABASE=stm_shritadkesh03112026
# DB_PORT=0
# DB_USER=SoftTradeWebUser
# DB_PASSWORD=SoftTrade$2336225
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Restrict which schemas the model can see, e.g. dbo,reporting. Empty = all of them.
ALLOWED_SCHEMAS=dbo

# ---- API ----
PORT=3000
CORS_ORIGIN=*
MAX_ROWS=200
MAX_ROWS_FOR_SUMMARY=50
QUERY_TIMEOUT_MS=30000
SCHEMA_TTL_MS=600000
