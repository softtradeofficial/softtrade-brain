# ---- Gemini Hybrid Router ----
OPENAI_API_KEY=your-gemini-api-key-here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
FAST_MODEL=gemini-3.5-flash-lite
STANDARD_MODEL=gemini-3.6-flash
OPENAI_MODEL=gemini-3.6-flash

# ---- SQL Server ----
DB_SERVER=localhost
DB_DATABASE=SoftTrade
DB_PORT=1433
# Named instance instead of a port (leave DB_PORT unused if you set this):
# DB_INSTANCE=SQLEXPRESS

# SQL authentication. Use a login that only has db_datareader - the API never writes,
# and a read-only login is your last line of defence.
DB_USER=softtrade_readonly
DB_PASSWORD=change-me

# Leave DB_USER and DB_PASSWORD blank to use Windows integrated authentication
# (requires: npm install msnodesqlv8).

DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Restrict which schemas the model can see, e.g. dbo,reporting. Empty = all of them.
ALLOWED_SCHEMAS=

# ---- API ----
PORT=3000
CORS_ORIGIN=http://localhost:4200
MAX_ROWS=200
MAX_ROWS_FOR_SUMMARY=50
QUERY_TIMEOUT_MS=30000
SCHEMA_TTL_MS=600000

# Document series codes (see backend/src/domain.ts)
SALES_INVOICE_SERIES=SIN
PURCHASE_INVOICE_SERIES=PIN,PIO
